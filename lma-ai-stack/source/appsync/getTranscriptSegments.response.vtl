#if ( $ctx.error )
  $util.error($ctx.error.message, $ctx.error.type)
#end

## allOps policy: every authenticated user (Admin or User) can read every
## meeting's transcript — see getCall.response.vtl for the rationale. No
## Owner/SharedWith filtering here by design.
$util.toJson({"TranscriptSegments": $ctx.result.items, "nextToken": $ctx.result.nextToken})
